<% layout("/layouts/boilerpate") -%>
<%
  const categoryIcons = {
    Rooms: "fa-solid fa-bed",
    "Iconic Cities": "fa-solid fa-mountain-city",
    Mountains: "fa-solid fa-mountain",
    Castles: "fa-brands fa-fort-awesome",
    "Amazing Pools": "fa-solid fa-person-swimming",
    Camping: "fa-solid fa-campground",
    Farms: "fa-solid fa-cow",
    Arctic: "fa-regular fa-snowflake",
    Boats: "fa-solid fa-sailboat",
    Domes: "fa-solid fa-igloo",
    Villas: "fa-solid fa-house-chimney",
    Beachfront: "fa-solid fa-umbrella-beach",
    Cabins: "fa-solid fa-tree",
    "Tiny Homes": "fa-solid fa-house",
  };
  const filters = [
    { category: "", label: "All", icon: "fa-solid fa-border-all" },
    { category: "Trending", label: "Trending", icon: "fa-solid fa-fire" },
    ...listingCategories.map(category => ({ category, label: category, icon: categoryIcons[category] })),
  ];
  const filterUrl = (category) => {
    const params = new URLSearchParams();
    if (searchTerm) params.set("search", searchTerm);
    if (category) params.set("category", category);
    return `/listings${params.size ? `?${params.toString()}` : ""}`;
  };
%>

<nav id="filters" aria-label="Filter listings by category">
  <% for (const filter of filters) { %>
    <a class="filter<%= selectedCategory === filter.category ? ' active' : '' %>"
      href="<%= filterUrl(filter.category) %>"
      <%- selectedCategory === filter.category ? 'aria-current="page"' : '' %>>
      <div><i class="<%= filter.icon %>" aria-hidden="true"></i></div>
      <span><%= filter.label %></span>
    </a>
  <% } %>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 my-3">
  <div>
    <p class="mb-1" role="status">
      <strong><%= allListings.length %></strong> <%= allListings.length === 1 ? 'listing' : 'listings' %>
      <% if (searchTerm) { %> matching &ldquo;<%= searchTerm %>&rdquo;<% } %>
      <% if (selectedCategory) { %> in <strong><%= selectedCategory %></strong><% } %>
    </p>
    <% if (searchTerm || selectedCategory) { %>
      <a href="/listings" class="clear-filters">Clear filters</a>
    <% } %>
  </div>
  <div class="tax-toggle form-switch" title="Show nightly prices including 18% tax">
    <label class="form-check-label" for="switchCheckDefault">
      <i class="fa-solid fa-receipt" aria-hidden="true"></i>
      Total after taxes <span class="tax-rate">18%</span>
    </label>
    <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  </div>
</div>

<% if (allListings.length === 0) { %>
  <div class="text-center py-5">
    <h2 class="h4">No listings found</h2>
    <p class="text-muted">
      <%= searchTerm || selectedCategory ? 'Try a different listing name or category.' : 'No listings are available yet.' %>
    </p>
  </div>
<% } else { %>
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 mt-3">
    <% for (const listing of allListings) { %>
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card col listing-card">
          <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" style="height: 20rem" />
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %></b><br />
              &#8377; <span class="listing-price" data-base-price="<%= listing.price %>"><%= listing.price.toLocaleString("en-IN") %></span> / night
              <span class="tax-info" hidden>incl. 18% tax</span>
            </p>
          </div>
        </div>
      </a>
    <% } %>
  </div>
<% } %>

<script>
  const taxSwitch = document.getElementById("switchCheckDefault");
  const priceFormatter = new Intl.NumberFormat("en-IN", { maximumFractionDigits: 2 });
  function updateDisplayedPrices() {
    for (const price of document.querySelectorAll(".listing-price")) {
      const basePrice = Number(price.dataset.basePrice);
      price.textContent = priceFormatter.format(taxSwitch.checked ? basePrice * 1.18 : basePrice);
    }
    for (const info of document.getElementsByClassName("tax-info")) {
      info.hidden = !taxSwitch.checked;
    }
  }
  taxSwitch.addEventListener("change", updateDisplayedPrices);
  updateDisplayedPrices();
</script>
